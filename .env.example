# PostgreSQL connection used by the Express API
DATABASE_URL=postgresql://sweety:sweety_dev_password@localhost:5432/sweety

# Use a long, random value in production (at least 32 characters)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Frontend origin for credentialed API requests
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
